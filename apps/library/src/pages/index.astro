---
import RootLayout from "../layouts/RootLayout.astro";
---

<RootLayout path="/">
	<style>
		body {
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 100vh;
			text-align: center;
			padding: 24px;
			-webkit-font-smoothing: antialiased;
			-moz-osx-font-smoothing: grayscale;
		}

		.container {
			max-width: 520px;
		}

		.badge {
			display: inline-block;
			font-size: 0.75rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: #666666;
			margin-bottom: 24px;
			border: 1px solid #e5e5e5;
			padding: 6px 14px;
			border-radius: 50px; /* Slight pill shape for elegance */
		}

		h1 {
			font-size: 2.2rem;
			font-weight: 500;
			letter-spacing: -0.03em;
			margin-bottom: 16px;
			color: #000000;
		}

		p {
			font-size: 1.05rem;
			line-height: 1.6;
			color: #555555;
			margin-bottom: 36px;
		}

		/* Premium Call to Action Button */
		.btn {
			display: inline-block;
			background-color: #000000;
			color: #ffffff;
			text-decoration: none;
			padding: 14px 32px;
			font-size: 0.95rem;
			font-weight: 500;
			border-radius: 4px;
			border: 1px solid #000000;
			transition: all 0.3s ease;
		}

		.btn:hover {
			background-color: #ffffff;
			color: #000000;
		}

		.footer {
			font-size: 0.85rem;
			color: #999999;
			margin-top: 48px;
		}
	</style>
	<div class="container">
		<div class="badge">Work in Progress</div>

		<h1>Under Development</h1>

		<p>
			The <strong>library.farhanali.org</strong> platform is currently undergoing
			a complete rebuild. Thank you for your patience while this new experience
			is being crafted.
		</p>

		<a href="https://farhanali.org" class="btn">View Main Portfolio</a>

		<div class="footer">&copy; 2026 Farhan Ali. All rights reserved.</div>
	</div>
</RootLayout>
